    <string name="camera_allow">Allow Camera</string>
    <string name="camera_blocked_title">Camera is turned off</string>
    <string name="camera_blocked_body">Open Settings, tap Permissions, then turn on Camera. Then come back here.</string>
    <string name="open_settings">Open Settings</string>
    <string name="no_camera_title">Camera not available</string>
    <string name="no_camera_body">Go back and tap Choose Photo instead.</string>

    <!-- Processing -->
    <string name="processing_title">Making your passport photos…</string>
    <string name="processing_body">This takes a few seconds.</string>
    <string name="cancel">Cancel</string>

