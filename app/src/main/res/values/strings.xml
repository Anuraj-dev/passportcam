<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Passport Photo</string>

    <!-- Home -->
    <string name="home_helper">Take a photo or choose one.\nWe make it passport size.</string>
    <string name="take_photo">Take Photo</string>
    <string name="choose_photo">Choose Photo</string>

    <!-- Camera -->
    <string name="back">Back</string>
    <string name="shutter">Take photo</string>
    <string name="flip_camera">Switch camera</string>
    <string name="camera_hint">Face in the middle</string>
    <string name="capture_failed">Could not take the photo. Please try again.</string>
    <string name="camera_ask_title">Use the camera</string>
