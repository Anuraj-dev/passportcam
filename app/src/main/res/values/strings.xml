    <string name="noface_title">No face found</string>
    <string name="noface_body">We could not find a face. Face the camera straight, make sure the face is clearly visible, then try again.</string>
    <string name="noface_small_body">The face is too small. Move closer so the face fills more of the picture, then try again.</string>
    <string name="failed_title">Sorry, something went wrong</string>
    <string name="failed_body">Please try again. If it keeps happening, try a different photo.</string>
