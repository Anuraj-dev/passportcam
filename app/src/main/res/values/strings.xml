    <string name="results_title">Your photos are ready</string>
    <string name="results_saved">Saved in your gallery: Pictures/PassportPhotos</string>
    <plurals name="results_skipped">
        <item quantity="one">%d face was too small and was skipped</item>
        <item quantity="other">%d faces were too small and were skipped</item>
    </plurals>
    <string name="results_empty">No photos left.</string>
    <string name="size_kb">%d KB</string>
    <string name="share">Share</string>
    <string name="share_chooser">Share photo</string>
    <string name="delete">Delete</string>
    <string name="delete_title">Delete this photo?</string>
    <string name="delete_body">It will be removed from your gallery.</string>
    <string name="keep">Keep</string>
    <string name="delete_failed">Could not delete this photo. Please try again.</string>
    <string name="share_failed">No app found to share with.</string>
    <string name="done">Done</string>
    <string name="take_another">Take another</string>
    <string name="photo_description">Passport photo %d</string>

